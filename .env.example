# --- Environment ---
ENVIRONMENT=local            # local | staging | production

# --- Postgres ---
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinelx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinelx:change-me-locally@postgres:5432/sentinelx

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (generate a real secret: `openssl rand -hex 32`) ---
JWT_SECRET_KEY=replace-with-a-real-64-char-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
